#version 450
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) uniform sampler2D hdrMap;
layout(std430, binding = 1) buffer Stats {
  uint minLum;
  uint maxLum;
} stats;

void main() {
  ivec2 p = ivec2(gl_GlobalInvocationID.xy);
  ivec2 size = textureSize(hdrMap, 0);
  if (p.x >= size.x || p.y >= size.y)
    return;

  vec3 c = texelFetch(hdrMap, p, 0).rgb;
  float lum = max(dot(c, vec3(0.2126, 0.7152, 0.0722)), 1e-4);
  uint bits = floatBitsToUint(lum);
  atomicMin(stats.minLum, bits);
  atomicMax(stats.maxLum, bits);
}
